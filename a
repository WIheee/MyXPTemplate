@Composable
private fun RowScope.Sidebar(currentTab: Int) {
    Column(
        Modifier
            .weight(2f)
            .fillMaxHeight()
            .clip(RoundedCornerShape(13.dp))
            .background(UiColors.BgSidebar)
            .padding(4.dp)
