# -*- coding: utf-8 -*-
"""
修复 insets 与 offset 两处编译错误。
======================================

问题
----
  1. addOnComputeInternalInsetsListener 在 Kotlin SAM 下不稳定
     → 改用 setOnComputeInternalInsetsListener + 显式匿名对象
  2. FloatIcon.kt 缺 androidx.compose.foundation.layout.offset 导入

放置位置
--------
    MyXPTemplate/                 ← 项目根目录
    ├── settings.gradle.kts
    ├── fix_insets.py             ← 把本脚本放在这里
    ...

运行
----
    cd MyXPTemplate
    python fix_insets.py

文件变更
--------
    [重写] overlay/OverlayService.kt   显式匿名对象 + 老 API
    [重写] ui/FloatIcon.kt             补 import
"""

import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))


def sanity_check():
    if not os.path.exists(os.path.join(ROOT, "settings.gradle.kts")):
        print("错误：当前目录找不到 settings.gradle.kts")
        print("请把本脚本放到 MyXPTemplate/ 下（与 settings.gradle.kts 同级）再运行。")
        sys.exit(1)


def write(rel, content):
    full = os.path.join(ROOT, rel)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "w", encoding="utf-8", newline="\n") as f:
        f.write(content)
    print("[WRITE ] " + rel)


