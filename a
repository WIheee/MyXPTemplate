        Box(
            Modifier
                .fillMaxWidth()
                .height(44.dp)
                .clip(RoundedCornerShape(9.dp))
                .background(UiColors.BgSidebarItem)
                .clickable { FeatureStore.menuVisible = false },
            contentAlignment = Alignment.Center
